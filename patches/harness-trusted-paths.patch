--- /dev/null
+++ b/packages/sandbox/sandbox-windows-acl/tests/extra-root-lease.spec.ts
@@ -0,0 +1,41 @@
+import { afterAll, describe, expect, it, vi } from 'vitest'
+import { mkdtempSync, mkdirSync, rmSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+const testHome = vi.hoisted(() => process.cwd())
+vi.mock('node:os', () => ({ homedir: () => testHome }))
+import { reserveExtraRootLease, readExtraRootLease, claimExtraRootLease, completeExtraRootLease, revokeExtraRoots, reconcileExtraRoots } from '../src/extra-root-lease.ts'
+const created: string[] = []
+function pair() {
+  const dir = mkdtempSync(join(process.cwd(), 'lease-unit-'))
+  created.push(dir)
+  const workspace = join(dir, 'workspace'); const root = join(dir, 'root')
+  mkdirSync(workspace); mkdirSync(root)
+  return { workspace, root }
+}
+afterAll(() => { for (const dir of created) rmSync(dir, { recursive: true, force: true }) })
+describe('extra-root leases', () => {
+  it('reserves before spawn, revokes future grants, and never expires running tokens', () => {
+    const { workspace, root } = pair()
+    const first = reserveExtraRootLease(workspace, [root]); const second = reserveExtraRootLease(workspace, [root])
+    expect(readExtraRootLease(first, workspace).roots[0]!.sid).not.toBe(readExtraRootLease(second, workspace).roots[0]!.sid)
+    expect(() => revokeExtraRoots(workspace, [root])).toThrow(/pending\/running/)
+    expect(() => reserveExtraRootLease(workspace, [root])).toThrow(/revoked/)
+    expect(() => reconcileExtraRoots(workspace, [root])).toThrow(/pending\/running/)
+    const running = claimExtraRootLease(first, workspace)
+    expect(() => claimExtraRootLease(first, workspace)).toThrow()
+    expect(() => claimExtraRootLease(running.path, workspace)).toThrow()
+    completeExtraRootLease(running.path); completeExtraRootLease(second)
+    revokeExtraRoots(workspace, [root])
+    expect(() => reserveExtraRootLease(workspace, [root])).toThrow(/revoked/)
+    reconcileExtraRoots(workspace, [root])
+    const last = reserveExtraRootLease(workspace, [root]); completeExtraRootLease(last)
+  })
+  it('rejects control-area overlap and arbitrary lease paths', () => {
+    const { workspace } = pair()
+    expect(() => reserveExtraRootLease(workspace, [process.cwd()])).toThrow(/disjoint/)
+    expect(() => reserveExtraRootLease(process.cwd(), [workspace])).toThrow(/disjoint/)
+    const arbitrary = join(workspace, 'forged.json')
+    writeFileSync(arbitrary, JSON.stringify({ workspace, roots: [] }))
+    expect(() => claimExtraRootLease(arbitrary, workspace)).toThrow()
+  })
+})
