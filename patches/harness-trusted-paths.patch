@@ -0,0 +1,107 @@
+/** Durable, fail-closed records for extra-root tokens. Never expire records by age/PID. */
+import { createHash, randomBytes } from 'node:crypto'
+import { existsSync, mkdirSync, readFileSync, readdirSync, renameSync, rmdirSync, unlinkSync, writeFileSync } from 'node:fs'
+import { homedir } from 'node:os'
+import { assertPrivateTempDisjoint } from './path-boundary.ts'
+import { basename, dirname, join, resolve } from 'node:path'
+
+export interface ExtraRootLease {
+  workspace: string
+  roots: Array<{ path: string; sid: string }>
+}
+export function extraRootControlDirectory(): string {
+  const dir = join(homedir(), '.dsh-trusted-paths-control')
+  mkdirSync(dir, { recursive: true })
+  return dir
+}
+function directory(workspace: string): string {
+  return join(extraRootControlDirectory(), createHash('sha256').update(workspace.toLowerCase()).digest('hex'))
+}
+/** Reserve before returning argv: an unspawned invocation must also block removal. */
+export function reserveExtraRootLease(workspace: string, roots: readonly string[]): string {
+  return withLeaseLock(workspace, () => reserve(workspace, roots))
+}
+function reserve(workspace: string, roots: readonly string[]): string {
+  // The control area is outside ambient tmp and every filesystem-tool writable root.
+  const control = extraRootControlDirectory()
+  assertPrivateTempDisjoint([workspace, ...roots], control)
+  assertExtraRootsEnabled(workspace, roots)
+  const dir = directory(workspace)
+  mkdirSync(dir, { recursive: true })
+  const path = join(dir, `${randomBytes(24).toString('hex')}.json`)
+  const lease: ExtraRootLease = { workspace, roots: roots.map(path => {
+    const random = randomBytes(16)
+    return { path, sid: `S-1-4-${random.readUInt32LE(0)}-${random.readUInt32LE(4)}-${random.readUInt32LE(8)}-${random.readUInt32LE(12)}-2` }
+  }) }
+  writeFileSync(path, JSON.stringify(lease), { flag: 'wx' })
+  return path
+}
+export function readExtraRootLease(path: string, workspace: string): ExtraRootLease {
+  if (dirname(resolve(path)).toLowerCase() !== resolve(directory(workspace)).toLowerCase()
+    || !/^[a-f0-9]{48}\.json(?:\.running\.json)?$/u.test(basename(path))) throw new Error('Invalid extra-root lease path')
+  const value = JSON.parse(readFileSync(path, 'utf8')) as ExtraRootLease
+  if (value === null || typeof value !== 'object' || typeof value.workspace !== 'string'
+    || value.workspace.toLowerCase() !== workspace.toLowerCase() || !Array.isArray(value.roots)
+    || value.roots.some(root => root === null || typeof root !== 'object' || typeof root.path !== 'string' || typeof root.sid !== 'string' || !/^S-1-4-(?:\d+-){4}2$/u.test(root.sid))) {
+    throw new Error('Invalid extra-root lease')
+  }
+  return value
+}
+/** Only after the entire Job is empty AND every revocable ACE cleanup succeeded. */
+export function completeExtraRootLease(path: string): void { unlinkSync(path) }
+/** Atomic single-use claim prevents replaying one lease into concurrent token owners. */
+export function claimExtraRootLease(path: string, workspace: string): { path: string; lease: ExtraRootLease } {
+  return withLeaseLock(workspace, () => {
+    if (!/^[a-f0-9]{48}\.json$/u.test(basename(path))) throw new Error('Extra-root lease already claimed')
+    const lease = readExtraRootLease(path, workspace)
+    const claimed = `${path}.running.json`
+    if (existsSync(claimed)) throw new Error('Extra-root lease already claimed')
+    renameSync(path, claimed)
+    return { path: claimed, lease }
+  })
+}
+function marker(workspace: string, root: string): string {
+  return join(directory(workspace), `${createHash('sha256').update(root.toLowerCase()).digest('hex')}.revoked`)
+}
+function assertExtraRootsEnabled(workspace: string, roots: readonly string[]): void {
+  if (roots.some(root => existsSync(marker(workspace, root)))) throw new Error('Additional writable root is revoked; reconcile it before execution')
+}
+/** Atomic directory lock: contention/crash fails closed instead of guessing ownership. */
+function withLeaseLock<T>(workspace: string, action: () => T): T {
+  const dir = directory(workspace)
+  mkdirSync(dir, { recursive: true })
+  const lock = join(dir, 'lock')
+  mkdirSync(lock)
+  try { return action() } finally { rmdirSync(lock) }
+}
+export function revokeExtraRoots(workspace: string, roots: readonly string[]): void {
+  withLeaseLock(workspace, () => {
+    for (const root of roots) writeFileSync(marker(workspace, root), '')
+    assertExtraRootsIdle(workspace, roots)
+  })
+}
+export function reconcileExtraRoots(workspace: string, roots: readonly string[]): void {
+  withLeaseLock(workspace, () => {
+    assertExtraRootsIdle(workspace, roots)
+    for (const root of roots) {
+      try { unlinkSync(marker(workspace, root)) } catch (error) {
+        if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error
+      }
+    }
+  })
+}
+/** Unknown, corrupt, pending, running and failed-cleanup records all block removal. */
+export function assertExtraRootsIdle(workspace: string, roots: readonly string[]): void {
+  let names: string[]
+  try { names = readdirSync(directory(workspace)) } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return
+    throw error
+  }
+  const wanted = new Set(roots.map(root => root.toLowerCase()))
+  for (const name of names.filter(name => name.endsWith('.json'))) {
+    const lease = readExtraRootLease(join(directory(workspace), name), workspace)
+    if (lease.roots.some(root => wanted.has(root.path.toLowerCase()))) {
+      throw new Error('Additional writable root still has a pending/running/unclean invocation; stop related tasks and retry. Never remove its lease until all token-bearing processes are proven terminated.')
+    }
+  }
+}
